# GNU Windows ABI, both cross-compiled and with a native Windows clang.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86)
set(TT_WINDOWS_X86 ON CACHE BOOL "Use the game's 32-bit Windows layouts")

set(TT_LLVM_ROOT "$ENV{TT_LLVM_ROOT}" CACHE PATH "LLVM installation prefix")
set(TT_MINGW_ROOT "$ENV{TT_MINGW_ROOT}" CACHE PATH "mingw-w64 installation prefix")
if(CMAKE_HOST_APPLE)
    if(NOT TT_LLVM_ROOT)
        set(TT_LLVM_ROOT /opt/homebrew/opt/llvm)
    endif()
    if(NOT TT_MINGW_ROOT)
        set(TT_MINGW_ROOT /opt/homebrew/opt/mingw-w64/toolchain-i686)
    endif()
endif()
find_program(CMAKE_C_COMPILER NAMES clang HINTS "${TT_LLVM_ROOT}/bin" REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES clang++ HINTS "${TT_LLVM_ROOT}/bin" REQUIRED)
set(CMAKE_C_COMPILER_TARGET i686-w64-windows-gnu)
set(CMAKE_CXX_COMPILER_TARGET i686-w64-windows-gnu)
set(CMAKE_C_FLAGS_INIT "-m32")
set(CMAKE_CXX_FLAGS_INIT "-m32 -fsjlj-exceptions")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -static-libgcc -static-libstdc++")
if(TT_MINGW_ROOT)
    set(CMAKE_SYSROOT "${TT_MINGW_ROOT}")
    list(APPEND CMAKE_FIND_ROOT_PATH "${TT_MINGW_ROOT}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# External Windows dependencies live outside the sysroot (no host libraries).
set(TT_WIN32_DEPS "${CMAKE_CURRENT_LIST_DIR}/../../build/win32-deps" CACHE PATH "Windows dependency directory")
list(APPEND CMAKE_FIND_ROOT_PATH "${TT_WIN32_DEPS}")
list(APPEND CMAKE_PREFIX_PATH "${TT_WIN32_DEPS}/SDL2-2.32.10/i686-w64-mingw32")
set(GLEW_ROOT "${TT_WIN32_DEPS}/glew-2.2.0" CACHE PATH "GLEW source tree")
